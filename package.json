{
  "name": "maazan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run db:migrate:local && vite dev",
    "build": "vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:api": "vitest run -c vitest.api.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:api && npm run build && MZ_SKIP_BUILD=1 playwright test",
    "db:migrate:local": "wrangler d1 migrations apply maazan --local",
    "seed:local": "node scripts/seed-local.mjs",
    "admin:recovery": "node scripts/admin-recovery.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:fixtures": "node scripts/gen-fixtures.mjs",
    "gen:card-pdf": "node scripts/gen-card-pdf.mjs",
    "deploy": "bash scripts/deploy.sh",
    "cf-types": "wrangler types --include-env=false"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tanstack/react-query": "^5.107.1",
    "hono": "^4.13.18",
    "i18next": "^27.1.1",
    "lucide-react": "^1.73.0",
    "nanoid": "^6.0.2",
    "papaparse": "^5.7.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.162.0"
  }
}
