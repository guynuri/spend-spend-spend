{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local development / tests use the top level (no Workers AI binding: it always needs a
  // remote session and Cloudflare credentials). Deploy uses env "production" (see DECISIONS.md).
  "name": "maazan",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maazan",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 2 * * *"] },
  "observability": { "enabled": true },
  "preview_urls": false,
  "vars": {
    "APP_HOST": "",
    "DEFAULT_LOCALE": "en",
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_BASE_URL": "",
    "AI_TRAINS_ON_INPUTS": "false",
    "AI_GLOBAL_DAILY_CALLS": "150"
  },
  "env": {
    "production": {
      "name": "maazan",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "maazan",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["17 2 * * *"] },
      "vars": {
        "APP_HOST": "",
        "DEFAULT_LOCALE": "en",
        "AI_PROVIDER": "workers-ai",
        "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "AI_BASE_URL": "",
        "AI_TRAINS_ON_INPUTS": "false",
        "AI_GLOBAL_DAILY_CALLS": "150"
      }
    }
  }
}
